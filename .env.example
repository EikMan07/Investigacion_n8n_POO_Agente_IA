# ==============================================================
# PLANTILLA DE CONFIGURACIÓN DEL PROYECTO (n8n + POO + REACT + DB)
# ==============================================================

# URLs del Webhook de n8n (Agente Orquestador)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/facturas
N8N_TEST_WEBHOOK_URL=http://localhost:5678/webhook-test/facturas

# Microservicio REST Local (backend-db con POO)
PORT=3001
DB_API_URL=http://localhost:3001/api

# Frontend Vite React
VITE_PORT=5174
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/facturas
VITE_DB_API_URL=http://localhost:3001/api

# Rutas de Carpetas y Archivos Pertinentes del Proyecto
PATH_BACKEND=./backend-db
PATH_FRONTEND=./facturas-ia
PATH_DB_FILE=./backend-db/db.json
PATH_COMPROBANTES=./comprobantes_ejemplo
PATH_WORKFLOWS=./n8n-workflows
PATH_DOCS=./docs

# Umbrales y Reglas de Negocio
UMBRAL_APROBACION_MONTO=50000
MONEDA_DEFAULT=CRC
