        "specifyBody": "json",
        "jsonBody": "={{ { canal: 'whatsapp', destinatario: $json.destinatario, mensaje: $json.mensaje, factura_id: $json.factura_id } }}",
        "options": {}
      },
      "id": "despacho-whatsapp",
      "name": "Despacho WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 520]
