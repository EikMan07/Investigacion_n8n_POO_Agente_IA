    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/notificaciones/enviar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { canal: 'slack', destinatario: $json.destinatario, mensaje: $json.mensaje, factura_id: $json.factura_id } }}",
        "options": {}
      },
