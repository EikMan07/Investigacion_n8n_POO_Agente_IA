{
  "name": "WF_Notificador_Notificar",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "canal",
              "type": "string"
            },
            {
              "name": "destinatario",
              "type": "string"
            },
            {
              "name": "mensaje",
              "type": "string"
            },
            {
              "name": "factura_id",
              "type": "string"
            }
          ]
        }
      },
      "id": "trigger-wf-notificador",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.canal || 'email' }}",
        "rules": {
          "rules": [
            {
              "value2": "email"
            },
            {
              "value2": "slack"
            },
            {
              "value2": "telegram"
            },
            {
              "value2": "whatsapp"
            }
          ]
        }
      },
      "id": "switch-canal",
